# Copy to docker/.env (or next to the compose file on the VM) and fill in.
# Never commit the real .env.
#
# Cloudflare Tunnel token — Dashboard → Networking → Tunnels → <your tunnel> →
# the long `eyJ…` string shown in the `docker run … --token <TOKEN>` command.
CF_TUNNEL_TOKEN=

# Which pushed image tag to run. `latest` tracks the newest release; pin to a
# released version (e.g. 1.0.0) for reproducible deploys.
IMAGE_TAG=latest
